# Copy to .env and fill in. Any OpenAI-compatible endpoint works.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL=llama3.1:8b

TEMPERATURE=0.2
MAX_TOKENS=1024
REQUEST_TIMEOUT=180
MAX_ITERATIONS=14

DATA_DIR=./data
HISTORY_TURNS=6

# Operations (safe defaults keep the CLI-only experience unchanged)
WEATHER_TIMEOUT=20
LOG_LEVEL=INFO
LOG_FORMAT=json
OBSERVABILITY_ENABLED=false
OBSERVABILITY_HOST=0.0.0.0
OBSERVABILITY_PORT=8080
